# Copy to .env (not committed) and adjust. Without these, Zou keeps its local
# accounts.
#
# Joins Zou to the Docker network of Keycloak so that it can reach it by name.
# KEYCLOAK_NETWORK (default mlw-platform_default) names that network.
COMPOSE_FILE=docker-compose.yml:docker-compose.keycloak.yml
# KEYCLOAK_NETWORK=mlw-platform_default

AUTH_STRATEGY=auth_remote_keycloak
# Keycloak as reached from inside the Zou container, not from the host.
KEYCLOAK_SERVER_URL=http://mlw-keycloak:8080
KEYCLOAK_REALM=mlw
KEYCLOAK_CLIENT_ID=mlw-kitsu
# Only for a confidential client; empty for a public one.
KEYCLOAK_CLIENT_SECRET=
# keycloak-role:kitsu-role pairs separated by semicolons. The most privileged
# match wins: map an admin role too, or nobody can administer Kitsu.
KEYCLOAK_ROLE_MAP=mlw-kitsu-user:user;mlw-kitsu-admin:admin
KEYCLOAK_DEFAULT_ROLE=user
# always: the role follows Keycloak at every login.
# first-login: set only when the person is created, later changes made in
# Kitsu are kept.
KEYCLOAK_SYNC_ROLE=always
