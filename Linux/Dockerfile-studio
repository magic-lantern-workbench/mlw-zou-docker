FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential \
      ffmpeg \
      git && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Clone Zou
RUN git clone https://github.com/cgwire/zou.git .

# Install Zou
RUN pip install --upgrade pip && \
    pip install .

# Default DB envs (ensure DB_USERNAME present)
ENV DB_HOST=postgres
ENV DB_PORT=5432
ENV DB_DATABASE=zoudb
ENV DB_USER=zou
ENV DB_USERNAME=zou
ENV DB_PASSWORD=zou
ENV KV_HOST=redis
ENV INDEXER_HOST=meilisearch
ENV SECRET_KEY=change-me

# Kitsu proxies /api and /socket.io to the backend host and strips the prefix.
# The target must be the backend root (for example http://localhost:5010), not
# a URL that already includes /api.
ENV KITSU_API_TARGET=http://localhost:5010
ENV KITSU_EVENT_TARGET=http://localhost:5001

# Ensure gevent-based event server support is available
RUN pip install gevent gevent-websocket

COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 5000

ENTRYPOINT ["/docker-entrypoint.sh"]
#CMD ["gunicorn", "-b", "0.0.0.0:5000", "zou.app:app"]
